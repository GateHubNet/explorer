{
  "name": "x-explorer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:sync": "tsx scripts/api-sync.ts",
    "api:check": "tsx scripts/api-sync.ts --check",
    "fixtures:sync": "tsx scripts/make-http-fixtures.ts",
    "fixtures:check": "tsx scripts/make-http-fixtures.ts --check",
    "deploy:staging": "CLOUDFLARE_ENV=staging react-router build && wrangler deploy",
    "deploy:production": "CLOUDFLARE_ENV=production react-router build && wrangler deploy",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "verify": "pnpm api:check && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@sentry/cloudflare": "^11.8.0",
    "bignumber.js": "^11.1.5",
    "geist": "^1.8.1",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "ripple-address-codec": "^5",
    "ripple-lib-transactionparser": "0.8.2",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^21.0.3",
    "openapi-typescript": "^7.13.0",
    "ripple-binary-codec": "^2.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
