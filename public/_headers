# Read by Cloudflare's static assets (and by the Cloudflare Vite plugin's local runtime), and copied into build/client/ by Vite.
# The files of /assets/ are named by a hash of their content (scripts, the stylesheet, the fonts), so a browser may keep them for good.
# Nothing else is listed: the pages are drawn by the Worker, whose cache classes (app/server/cache-class.ts) set their headers.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
