/**
 * Worker configuration. Details: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Three blocks, three environments (README, "The pipeline and deploying"):
 *  - the top level is local development and the tests: the Worker `x-explorer`, no route, `ENVIRONMENT` "development" (mainnet facts, because
 *    every fixture is mainnet data), placeholder data API hosts (`.invalid` never resolves, so that local development and the tests never reach a
 *    deployed data API by accident) and the public mainnet nodes;
 *  - `sandbox` is the deployed test environment: the Worker `x-explorer-sandbox` on explorer.sandbox.gatehub.net, showing XRPL Testnet and Xahau
 *    Testnet, from the sandbox data APIs and Ripple's testnet Clio and Xahau Testnet's node;
 *  - `production` is the Worker `x-explorer-production` on explorer.gatehub.net, showing XRPL and Xahau mainnet, from the production data APIs
 *    and the public mainnet nodes.
 * `sandbox` and `production` are selected at build time (`CLOUDFLARE_ENV=sandbox react-router build`, see the `deploy:*` scripts), because
 * the Cloudflare Vite plugin writes a flattened config for the selected environment.
 *
 * `vars` and `ratelimits` are not inherited, so each environment repeats them, `ENVIRONMENT` and the switches among them.
 * `ENVIRONMENT` is "development", "sandbox" or "production": it decides whether the pages show mainnets or testnets. The XRPL node of a deployed
 * environment must be a Clio (a rippled answers `nft_info` with `unknownCmd`).
 * `VALIDATORS`, `AMM_DATA`, `MARKETS`, `ACCOUNT_ANALYTICS` and `AMM_PAGES` are the switches (app/ui/features.ts, README "Switches"): "on" or "off", in every block. The top level is
 * what local development and the tests run, so a switch is "on" there from the moment the code it gates is built (`VALIDATORS` since the
 * validators pages were); `sandbox` and `production` are "off" until their data API serves what the switch needs. Set
 * one by a commit and a deploy, never in the Cloudflare dashboard: the next deploy would undo it. The predeploy guard refuses a build
 * where one is missing, is anything but "on" or "off", or is misspelt, or where `AMM_PAGES` is "on" and `AMM_DATA` is not (the AMM pages need the AMM data).
 * `BUILD_ID` is not listed here: vite.config.ts adds the git commit to the vars of every build.
 * Secrets (`DATA_API_KEY`, `SENTRY_DSN`) are never listed: `.dev.vars` locally,
 * `wrangler secret put --env <env>` when deployed.
 *
 * `scripts/predeploy-check.ts` refuses to let a build be deployed whose `ENVIRONMENT`, data API URLs, node URLs or route are not its
 * environment's (a testnet answer must never be served from production, nor the reverse), or that has a placeholder or a non-https URL:
 * the `deploy:*` scripts run it between the build and `wrangler deploy`.
 *
 * `sandbox` and `production` are served from their custom domains (`routes`), not from `*.workers.dev` (`workers_dev` and `preview_urls` are
 * false): the Cache API does nothing there, so every request would render and call the data API, and the
 * Worker would be a second, duplicate site.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "x-explorer",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"ENVIRONMENT": "development",
		"XRPL_DATA_API_URL": "https://xrpl.data.example.invalid",
		"XAHAU_DATA_API_URL": "https://xahau.data.example.invalid",
		"XRPL_NODE_URL": "https://s1.ripple.com:51234/",
		"XAHAU_NODE_URL": "https://xahau.network/",
		"VALIDATORS": "on",
		"AMM_DATA": "on",
		"MARKETS": "on",
		"ACCOUNT_ANALYTICS": "on",
		"AMM_PAGES": "on"
	},
	"ratelimits": [
		{
			"name": "VISITOR_LIMITER",
			"namespace_id": "1000",
			"simple": { "limit": 60, "period": 10 }
		}
	],
	"env": {
		"sandbox": {
			"name": "x-explorer-sandbox",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "explorer.sandbox.gatehub.net", "custom_domain": true }],
			"vars": {
				"ENVIRONMENT": "sandbox",
				"XRPL_DATA_API_URL": "https://xrpl.data.sandbox.gatehub.net",
				"XAHAU_DATA_API_URL": "https://xahau.data.sandbox.gatehub.net",
				"XRPL_NODE_URL": "https://clio.altnet.rippletest.net:51234/",
				"XAHAU_NODE_URL": "https://xahau-test.net/",
				"VALIDATORS": "off",
				"AMM_DATA": "off",
				"MARKETS": "off",
				"ACCOUNT_ANALYTICS": "off",
				"AMM_PAGES": "off"
			},
			"ratelimits": [
				{
					"name": "VISITOR_LIMITER",
					"namespace_id": "1001",
					"simple": { "limit": 60, "period": 10 }
				}
			]
		},
		"production": {
			"name": "x-explorer-production",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "explorer.gatehub.net", "custom_domain": true }],
			"vars": {
				"ENVIRONMENT": "production",
				"XRPL_DATA_API_URL": "https://xrpl.data.gatehub.net",
				"XAHAU_DATA_API_URL": "https://xahau.data.gatehub.net",
				"XRPL_NODE_URL": "https://s1.ripple.com:51234/",
				"XAHAU_NODE_URL": "https://xahau.network/",
				"VALIDATORS": "off",
				"AMM_DATA": "off",
				"MARKETS": "off",
				"ACCOUNT_ANALYTICS": "off",
				"AMM_PAGES": "off"
			},
			"ratelimits": [
				{
					"name": "VISITOR_LIMITER",
					"namespace_id": "1002",
					"simple": { "limit": 60, "period": 10 }
				}
			]
		}
	}
}
