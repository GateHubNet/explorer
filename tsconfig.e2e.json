{
  "extends": "./tsconfig.json",
  "include": [
    "playwright.config.ts",
    "test/e2e/**/*.spec.ts",
    "test/e2e/support.ts",
    "test/e2e/fixtures.ts",
    "test/e2e/fixture-control.ts",
    "test/e2e/validators-pages.ts",
    "test/e2e/names-pages.ts",
    "test/e2e/object-pages.ts",
    "test/e2e/token-pages.ts",
    "test/e2e/mpt-pages.ts",
    "test/support/loader-data.ts",
    "test/support/mpt-case-rules.ts",
    "test/support/nft-names.ts",
    "test/support/object-case-rules.ts",
    "test/support/token-case-rules.ts",
    "app/server/api-types.ts",
    "app/domain/amendments-params.ts",
    "app/domain/analytics-params.ts",
    "app/domain/format.ts",
    "app/domain/parse/types.ts",
    "app/domain/window.ts",
    "scripts/e2e-env.ts",
    "app/ui/features.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
