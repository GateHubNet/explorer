{
  "extends": "./tsconfig.json",
  "include": [
    "playwright.config.ts",
    "test/e2e/**/*.spec.ts",
    "test/e2e/support.ts",
    "test/e2e/fixtures.ts",
    "test/e2e/fixture-control.ts",
    "test/e2e/validators-pages.ts",
    "scripts/e2e-env.ts",
    "app/ui/features.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
