{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "scripts/**/*",
    "test/unit/**/*",
    "test/e2e/stack.ts",
    "test/support/upstream-core.ts",
    "test/support/book-fixtures.ts",
    "test/support/ledger-edits.ts",
    "test/support/fixture-server.ts",
    "test/support/switches.ts",
    "test/support/value-imports.ts",
    "app/server/aggregate-shape.ts",
    "app/server/api-types.ts",
    "app/server/marker.ts",
    "app/server/pending-paths.ts",
    "app/server/tx-shape.ts",
    "app/server/upstream.ts",
    "app/ui/features.ts",
    "app/domain/amendments-params.ts",
    "app/domain/asset.ts",
    "app/domain/market-pair.ts",
    "app/domain/market-params.ts",
    "app/domain/paging.ts",
    "app/domain/parse/amm-hops.ts",
    "app/domain/parse/objects.ts",
    "app/domain/parse/types.ts",
    "app/domain/window.ts",
    "app/domain/fnv.ts",
    "app/domain/format.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  }
}
