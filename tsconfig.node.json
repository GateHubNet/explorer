{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "scripts/**/*",
    "test/unit/**/*",
    "test/e2e/stack.ts",
    "test/support/upstream-core.ts",
    "test/support/fixture-server.ts",
    "test/support/switches.ts",
    "app/server/api-types.ts",
    "app/ui/features.ts",
    "app/domain/parse/types.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
